# AutoSIEM environment reference.
# Copy to `.env` and source it, or export the vars you need. Nothing here is
# required — every value has a working default. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Storage & rules
# ---------------------------------------------------------------------------
# SQLite database used by the CLI and the API.
AUTOSIEM_DB=data/autosiem.db
# Detection rule file or directory.
AUTOSIEM_RULES=rules

# ---------------------------------------------------------------------------
# Dashboard launcher (scripts/run_dashboard.sh)
# ---------------------------------------------------------------------------
AUTOSIEM_HOST=127.0.0.1
AUTOSIEM_PORT=8000

# ---------------------------------------------------------------------------
# API authentication — pick ONE of the three modes below.
# The API fails closed: with none of these set, every /api/* and state-changing
# /ui/* request returns 401.
# ---------------------------------------------------------------------------
# Mode 1 (recommended) — multi-tenant RBAC. Manage with `autosiem users add`.
# Tokens are stored as sha256 hashes; the plaintext is shown only once.
#AUTOSIEM_RBAC_FILE=data/rbac_users.json

# Mode 2 — single shared bearer token (legacy, no roles: caller is admin).
#AUTOSIEM_API_TOKEN=change-me

# Mode 3 — local development only. Disables API auth entirely.
# Never set this on a host reachable by anything but localhost.
#AUTOSIEM_AUTH_INSECURE=1

# Separate token for the machine-to-machine ingest endpoint (POST /api/ingest),
# sent as `x-api-key` or `Authorization: Bearer`. Independent of the guards above.
#AUTOSIEM_INGEST_TOKEN=change-me

# Shared secret enabling CSRF tokens on /ui/* form POSTs. Unset = CSRF checks
# are a no-op, so set this whenever the UI is reachable from a browser you do
# not fully control.
#AUTOSIEM_CSRF_SECRET=change-me

# ---------------------------------------------------------------------------
# Ingest limits (POST /api/ingest)
# ---------------------------------------------------------------------------
AUTOSIEM_MAX_INGEST_BYTES=10485760
AUTOSIEM_MAX_INGEST_EVENTS=10000

# ---------------------------------------------------------------------------
# Distributed pipeline (all opt-in; unset = single-threaded SQLite mode).
# Inspect with: autosiem distributed [--replay]
# Alternate backends store EVENTS ONLY - findings, incidents, investigations
# and the audit chain always stay in SQLite.
# ---------------------------------------------------------------------------
# SQLite durable queue for backpressure and crash replay.
#AUTOSIEM_QUEUE_PATH=data/queue.db
#AUTOSIEM_QUEUE_MAX_PENDING=10000

# Append-only JSON-lines journal of raw records, for durability.
#AUTOSIEM_ARCHIVE_PATH=data/archive.jsonl

# Parser worker pool size. Applies only to library use of DistributedPipeline
# without an injected pipeline: CLI ingest/listen always inject the configured
# pipeline so suppressions, threat intel, RAG, SOAR and the baseline apply.
#AUTOSIEM_WORKERS=4

# Alternate event backend: sqlite (default), clickhouse, or opensearch.
#AUTOSIEM_BACKEND=clickhouse
#AUTOSIEM_BACKEND_URL=http://localhost:8123
#AUTOSIEM_BACKEND_TABLE=events
#AUTOSIEM_BACKEND_INDEX=events

# ---------------------------------------------------------------------------
# API-native connectors
# ---------------------------------------------------------------------------
# Okta System Log API token (SSWS). Read from the environment on purpose: the
# CLI takes --token-env, never --token, so the secret stays out of shell
# history and the process list. A free Okta developer org works.
#   autosiem poll --connector okta-api --url https://dev-123456.okta.com --db data/autosiem.db
#AUTOSIEM_OKTA_TOKEN=00abc...

# ---------------------------------------------------------------------------
# Entity enrichment (all local, all free - no API keys, no third-party calls)
# ---------------------------------------------------------------------------
# Asset inventory. JSON array or JSONL. Same record shape as the `asset`
# connector, so one export feeds both ingestion and enrichment.
# A `criticality` of critical/high/medium/low scales the risk of findings that
# touch the asset (x2.0 / x1.5 / x1.0 / x0.75). Unlisted assets score unchanged.
#AUTOSIEM_ASSET_FILE=examples/assets.json

# Identity directory export. Adds department/title/manager context, and treats
# privileged or disabled accounts as critical.
#AUTOSIEM_IDENTITY_FILE=examples/identities.json

# Named CIDR ranges: {"corp-vpn": ["10.8.0.0/16"], "dmz": ["10.9.0.0/16"]}
# IP classification (private/public/loopback/documentation) is always on and
# needs no configuration; these ranges just make it more specific.
#AUTOSIEM_NETWORK_FILE=examples/network_ranges.json
#AUTOSIEM_NETWORK_RANGES={"corp-vpn":["10.8.0.0/16"]}

# ---------------------------------------------------------------------------
# Optional LLM analyst. Unset = the deterministic local investigator is used
# and no network call is ever made. Any OpenAI-compatible server works
# (LM Studio, Ollama, vLLM, OpenAI, ...).
# ---------------------------------------------------------------------------
#AUTOSIEM_LLM_BACKEND=openai_compat
#AUTOSIEM_LLM_URL=http://localhost:1234/v1
#AUTOSIEM_LLM_MODEL=your-model-name
#AUTOSIEM_LLM_API_KEY=
#AUTOSIEM_LLM_TEMPERATURE=0.2
# Unset by default (no nucleus sampling cap).
#AUTOSIEM_LLM_TOP_P=0.9
#AUTOSIEM_LLM_MAX_TOKENS=800
# Unset by default (no client-side context trimming).
#AUTOSIEM_LLM_CONTEXT_WINDOW=8192
# Redact PII/secrets before any prompt leaves the process. Leave on.
#AUTOSIEM_LLM_MASK_PII=1

# ---------------------------------------------------------------------------
# ATT&CK matrix. A distilled index ships inside the package, so coverage works
# offline with no configuration. Point this at a writable copy to use a matrix
# refreshed by `cli update --refresh-attack` (which writes <db>.attack.json by
# default). Unset = the vendored index.
# ---------------------------------------------------------------------------
#AUTOSIEM_ATTACK_INDEX=./data/autosiem.attack.json

# ---------------------------------------------------------------------------
# Vulnerability context (fifth enricher). A host with open CVEs is background
# noise; a host with an ACTIVELY EXPLOITED one is the first thing to look at,
# so only the CISA KEV subset raises criticality. Both are optional and local.
# Refresh the catalogue with `cli update --refresh-kev`.
# ---------------------------------------------------------------------------
# Host -> CVE inventory export: {"host": "web-01", "cves": ["CVE-2021-44228"]}
#AUTOSIEM_VULN_FILE=./data/vulnerabilities.jsonl
# Cached CISA KEV catalogue (written by `cli update --refresh-kev`).
#AUTOSIEM_KEV_FILE=./data/autosiem.kev.json

# ---------------------------------------------------------------------------
# Synced SigmaHQ rules. Written by `cli sigma-sync`; unset means only the
# curated rules/ directory is loaded. Curated rules win on a rule-id collision.
# ---------------------------------------------------------------------------
#AUTOSIEM_SIGMA_DIR=./data/autosiem.sigma
