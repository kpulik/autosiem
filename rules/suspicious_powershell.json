// Starter detection: encoded PowerShell execution
// Uses JSON after stripping these leading comments.
{
  "id": "AUTO-EXEC-001",
  "name": "Encoded PowerShell command",
  "description": "Detects PowerShell execution with encoded command flags often used for obfuscation.",
  "severity": "high",
  "risk_points": 85,
  "selection": {
