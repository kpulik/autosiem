// NTDS — covers MITRE ATT&CK T1003.003
{
  "id": "AUTO-CRED-003",
  "name": "Domain credential database extracted",
  "description": "Detects extraction of NTDS.dit, the file holding every domain account hash (ntdsutil ifm create, vssadmin create shadow followed by a copy of ntds.dit, diskshadow scripts, esentutl on the database). This is the credential-access step that turns one compromised host into the whole domain, so it is critical rather than high: after this, password resets are the only remediation. Domain controller backup jobs use ntdsutil legitimately; allowlist the backup account and the scheduled window.",
  "severity": "critical",
  "risk_points": 85,
  "selection": {
    "category": "process",
    "command_line": {
      "contains_any": [
        "ntdsutil",
        "ntds.dit",
        "diskshadow",
        "vssadmin create shadow"
      ]
    }
  },
  "mitre_attack": [
    "T1003.003"
  ],
  "tags": [
    "credential-access",
    "domain",
    "endpoint",
    "crown-jewel"
  ]
}
