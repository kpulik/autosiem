// Credential dumping — covers MITRE ATT&CK T1003 (OS Credential Dumping)
{
  "id": "AUTO-CRED-002",
  "name": "Credential dumping tool in use",
  "description": "Detects known credential-dumping tools (mimikatz, procdump, secretsdump, ...) launched with dump indicators (sekurlsa, lsass, comsvcs). After gaining a foothold, attackers dump credentials (T1003) to harvest passwords and hashes for lateral movement and persistence. Treat as a confirmed compromise signal.",
  "severity": "critical",
  "risk_points": 100,
  "selection": {
    "category": "process",
    "process_name": {"contains_any": ["mimikatz", "procdump", "secretsdump", "pypykatz", "lsassy", "wce", "cachedump"]},
    "command_line": {"contains_any": ["lsass", "sekurlsa", "logonpasswords", "minidump", "comsvcs"]}
  },
  "mitre_attack": ["T1003", "T1003.001"],
  "tags": ["credential-access", "credential-dumping", "endpoint"]
}
